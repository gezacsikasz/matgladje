# Kopiera till .env och fyll i riktiga värden. .env checkas aldrig in.

# Matchar docker-compose.yml som den är, ändra vid behov.
DATABASE_URL="postgresql://matgladje:matgladje@localhost:5432/matgladje?schema=public"

# Genereras t.ex. med: openssl rand -base64 32
AUTH_SECRET="generera-en-egen-hemlighet"

# Bootstrap-admin skapas av seed-scriptet med dessa uppgifter.
ADMIN_EMAIL="admin@matgladje.se"
ADMIN_PASSWORD="byt-mig-direkt"
